{
  "$defs": {
    "AIDisclosure": {
      "additionalProperties": false,
      "properties": {
        "in_film": {
          "const": true,
          "title": "In Film",
          "type": "boolean"
        },
        "end_card_text": {
          "maxLength": 240,
          "minLength": 5,
          "title": "End Card Text",
          "type": "string"
        }
      },
      "required": [
        "in_film",
        "end_card_text"
      ],
      "title": "AIDisclosure",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "maxLength": 1200,
          "minLength": 20,
          "title": "Descriptor",
          "type": "string"
        },
        "ref_sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Sheet"
        },
        "origin": {
          "enum": [
            "fictional",
            "consented_real",
            "real"
          ],
          "title": "Origin",
          "type": "string"
        },
        "consent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Id"
        },
        "consent_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Record"
        }
      },
      "required": [
        "descriptor",
        "origin"
      ],
      "title": "Character",
      "type": "object"
    },
    "Music": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "maxLength": 2000,
          "minLength": 20,
          "title": "Prompt",
          "type": "string"
        },
        "instrumental": {
          "title": "Instrumental",
          "type": "boolean"
        },
        "duration_s": {
          "maximum": 600,
          "minimum": 10,
          "title": "Duration S",
          "type": "number"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "selected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/MusicCue"
          },
          "title": "Cues",
          "type": "array"
        }
      },
      "required": [
        "prompt",
        "instrumental",
        "duration_s"
      ],
      "title": "Music",
      "type": "object"
    },
    "MusicCue": {
      "additionalProperties": false,
      "properties": {
        "at_shot": {
          "pattern": "^s[0-9]{2}$",
          "title": "At Shot",
          "type": "string"
        },
        "action": {
          "enum": [
            "fade_in",
            "swell",
            "drop",
            "fade_out"
          ],
          "title": "Action",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "at_shot",
        "action"
      ],
      "title": "MusicCue",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$",
          "title": "Lang",
          "type": "string"
        },
        "subtitle_text": {
          "anyOf": [
            {
              "maxLength": 3000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle Text"
        },
        "lexicon": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lexicon",
          "type": "object"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "Narration",
      "type": "object"
    },
    "NarrationVoice": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Model",
          "type": "string"
        },
        "voice": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Voice",
          "type": "string"
        },
        "style_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Prompt"
        }
      },
      "required": [
        "model",
        "voice"
      ],
      "title": "NarrationVoice",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^s[0-9]{2}$",
          "title": "Id",
          "type": "string"
        },
        "duration_s": {
          "maximum": 30,
          "minimum": 3,
          "title": "Duration S",
          "type": "number"
        },
        "image_prompt": {
          "maxLength": 2000,
          "minLength": 20,
          "title": "Image Prompt",
          "type": "string"
        },
        "motion_prompt": {
          "maxLength": 1200,
          "minLength": 10,
          "title": "Motion Prompt",
          "type": "string"
        },
        "camera": {
          "enum": [
            "static",
            "push_in",
            "pull_out",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down"
          ],
          "title": "Camera",
          "type": "string"
        },
        "characters": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Characters",
          "type": "array"
        },
        "vertical_crop_x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Vertical Crop X",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "narration": {
          "$ref": "#/$defs/Narration"
        },
        "subtitle_en": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Subtitle En",
          "type": "string"
        },
        "transition": {
          "enum": [
            "cut",
            "crossfade",
            "fade",
            "fade_black"
          ],
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "id",
        "duration_s",
        "image_prompt",
        "motion_prompt",
        "camera",
        "vertical_crop_x",
        "narration",
        "subtitle_en",
        "transition"
      ],
      "title": "Shot",
      "type": "object"
    },
    "StyleConfig": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Block",
          "type": "string"
        },
        "negative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative"
        }
      },
      "required": [
        "block"
      ],
      "title": "StyleConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storyboard_version": {
      "minimum": 1,
      "title": "Storyboard Version",
      "type": "integer"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "logline": {
      "maxLength": 500,
      "minLength": 20,
      "title": "Logline",
      "type": "string"
    },
    "language": {
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$",
      "title": "Language",
      "type": "string"
    },
    "subtitle_language": {
      "title": "Subtitle Language",
      "type": "string"
    },
    "target_runtime_s": {
      "maximum": 90,
      "minimum": 60,
      "title": "Target Runtime S",
      "type": "number"
    },
    "shot_count": {
      "maximum": 12,
      "minimum": 8,
      "title": "Shot Count",
      "type": "integer"
    },
    "aspect_ratios": {
      "items": {
        "enum": [
          "16:9",
          "9:16"
        ],
        "type": "string"
      },
      "title": "Aspect Ratios",
      "type": "array"
    },
    "style": {
      "$ref": "#/$defs/StyleConfig"
    },
    "narration_voice": {
      "$ref": "#/$defs/NarrationVoice"
    },
    "ai_disclosure": {
      "$ref": "#/$defs/AIDisclosure"
    },
    "characters": {
      "additionalProperties": {
        "$ref": "#/$defs/Character"
      },
      "minProperties": 1,
      "title": "Characters",
      "type": "object"
    },
    "music": {
      "$ref": "#/$defs/Music"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "maxItems": 12,
      "minItems": 8,
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "storyboard_version",
    "title",
    "logline",
    "language",
    "subtitle_language",
    "target_runtime_s",
    "shot_count",
    "aspect_ratios",
    "style",
    "narration_voice",
    "ai_disclosure",
    "characters",
    "music",
    "shots"
  ],
  "title": "Storyboard",
  "type": "object"
}
