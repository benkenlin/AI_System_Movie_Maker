# Google AI Studio / Gemini Developer API
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=Warm, clear, natural documentary narration; measured pace and gentle emotional restraint.

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
IMAGE_PROVIDER=cloudflare

# Wan 2.2 TI2V-5B: clone official repo and download its checkpoint in the GPU environment
WAN_REPO_DIR=
WAN_CHECKPOINT_DIR=
# Set WAN_WORKER_TOKEN on the GPU host; set VIDEO_WORKER_TOKEN to the same value on this app host.
WAN_WORKER_TOKEN=
WAN_SIZE=1280*704
WAN_NPROC_PER_NODE=1
WAN_WORKER_TIMEOUT_S=7200
# For local GPU host use VIDEO_GENERATION_COMMAND; for Kaggle/Colab worker API use VIDEO_WORKER_URL.
VIDEO_GENERATION_COMMAND=python workers/wan_worker.py --input {input_json} --output {output}
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
VIDEO_WORKER_TIMEOUT_S=7200

# ACE-Step 1.5: start official API server in GPU environment
ACE_STEP_API_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_WORKER_TIMEOUT_S=3600
MUSIC_GENERATION_COMMAND=python workers/ace_step_worker.py --input {input_json} --output {output}

PROVIDER_TIMEOUT_S=180
AI_CONTENT_OUTPUT_DIR=outputs
